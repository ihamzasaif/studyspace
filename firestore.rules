rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthorizedUser(userId) {
      return isOwner(userId) || isValidId(userId);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == userId &&
             data.username is string &&
             data.username.size() > 0 &&
             data.username.size() <= 64 &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 120;
    }

    // Study state document validation
    function isValidStudyState(data, userId) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == userId &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    // User Document Rules
    match /users/{userId} {
      allow get: if isAuthorizedUser(userId);
      allow create: if isAuthorizedUser(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isAuthorizedUser(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Study Data Subcollection Rules (Real-time multi-device sync)
      match /studyData/{dataId} {
        allow get, list: if isAuthorizedUser(userId);
        allow create: if isAuthorizedUser(userId) && isValidId(dataId) && isValidStudyState(incoming(), userId);
        allow update: if isAuthorizedUser(userId) && isValidId(dataId) && isValidStudyState(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }

    // Firestore connection health check test path
    match /test/connection {
      allow get: if true;
    }
  }
}
