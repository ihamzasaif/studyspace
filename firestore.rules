rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.username is string &&
             data.username.size() > 0 &&
             data.username.size() <= 64 &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 120;
    }

    // Study state document validation
    function isValidStudyState(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    // User Document Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Study Data Subcollection Rules (Real-time synchronization)
      match /studyData/{dataId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(dataId) && isValidStudyState(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(dataId) && isValidStudyState(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }

    // Firestore connection health check test path
    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
